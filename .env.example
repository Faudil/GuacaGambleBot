# ─────────────────────────────────────────────
# GuacaGambleBot — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# REQUIRED: You must at least set DISCORD_TOKEN.
# Everything else has a sensible default.
# ─────────────────────────────────────────────

# ─── Discord ──────────────────────────────────
# Your bot token from the Discord Developer Portal.
# REQUIRED — the bot will not start without it.
DISCORD_TOKEN=

# Guild (server) ID for development. When set to a specific server,
# slash commands are registered instantly (guild-scoped).
# Leave empty or 0 for global command registration (may take ~1 hour).
GUILD_ID=0

# ─── Bot Behaviour ────────────────────────────
# Default command prefix for text (prefixed) commands.
# Users can override this per-server with /setup.
PREFIX=!

# Server default starting balance for new players.
STARTING_BALANCE=100

# Amount given by the !daily command.
DAILY_AMOUNT=50

# Base jackpot for the lotto system.
BASE_JACKPOT=500

# Daily hunt limit and cooldown between hunts (seconds). Set to 0 to disable.
HUNT_MAX_PER_DAY=10
HUNT_COOLDOWN_SECONDS=10

# Cooldown between /play sessions with your pet (minutes). Set to 0 to disable.
PLAY_COOLDOWN_MINUTES=60

# Cooldown between NPC discussions (hours). Reputation from chatting
# diminishes daily: 50, 25, 10, then 5 per NPC. Set to 0 to disable.
NPC_CHAT_COOLDOWN_HOURS=6

# ─── Database ─────────────────────────────────
# Path to the SQLite database file (created automatically).
DB_PATH=./data/guacabot_go.db

# ─── Timezone ─────────────────────────────────
# Server timezone (e.g. America/New_York, Europe/Paris, UTC).
# Leave empty to use the system timezone.
TZ=

# ─── Logging ───────────────────────────────────
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: text (default) or json
LOG_FORMAT=text

# Include source file and line number in log entries (true/false)
LOG_ADD_SOURCE=false

# Log file path (leave empty to log to stderr)
LOG_FILE=

# ─── Universe ──────────────────────────────────
# Active universe for lore/NPC systems (hoakhaven, scorch, scifi).
UNIVERSE=hoakhaven

# ─── Channel IDs (optional) ────────────────────
# Announcement channel for weekly pet tournament results.
# CHANNEL_ID=0
# Channel for admin test commands.
# TEST_CHANNEL_ID=0
# Channel for pet battle announcements.
# PET_CHANNEL_ID=0

# ─── Environment ──────────────────────────────
# Optional environment label (e.g. "development", "production").
# Currently not used by the bot logic, but available for your tooling.
ENVIRONMENT=
